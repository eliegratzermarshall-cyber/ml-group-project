################################################################################
#6. Tuning with 10-fold cross validation (caret)
################################################################################
#Criterion: ROC-AUC. Accuracy is not useful here, because predicting
#"survived" for every bank already gives a very high accuracy (see section 11).
#caret's "rf" method tunes mtry; a loop around it tries each ntree.

#6a. Tuning subsample ----------------------------------------------------------

#The hyperparameters are chosen on a subsample of the training data: all
#failed banks plus tune_n_surv randomly drawn surviving banks, so each forest
#is small enough to grow quickly. ROC-AUC only depends on the ranking of banks,
#so it is comparable across mtry/ntree even though failures are more frequent
#in the subsample. The chosen combination is refit on the FULL training data
#(section 8b), with the natural class mix, like the baseline.

fail_idx <- which(train_y == "failed")
surv_idx <- which(train_y == "survived")

set.seed(123)
tune_idx <- c(fail_idx, sample(surv_idx, min(length(surv_idx), tune_n_surv)))
tune_x   <- train_x[tune_idx, ]
tune_y   <- train_y[tune_idx]

table(tune_y)   # check: class counts

#6b. Folds ---------------------------------------------------------------------

#Fixed folds, so every combination is compared on exactly the same splits.
#Split by bank (CERT): all quarters of a bank are in the same fold, so the
#model is never validated on a bank it was trained on.
set.seed(123)
cv_folds <- groupKFold(train_data$CERT[tune_idx], k = 10)

sapply(cv_folds, function(tr) sum(tune_y[-tr] == "failed"))   # failures per fold, all should be > 0

ctrl_cv10 <- trainControl(method          = "cv",
                          index           = cv_folds,
                          classProbs      = TRUE,          # needed for ROC-AUC
                          summaryFunction = twoClassSummary)

#6c. Tuning --------------------------------------------------------------------

#For each ntree, train() tries every mtry. The results are stacked in one table.
if (run_tuning) {
  tuning_start <- Sys.time()
  cv10_tuning <- NULL
  for (nt in ntree_grid) {
    set.seed(123)
    fit <- train(x = tune_x, y = tune_y, method = "rf", metric = "ROC",
                 trControl = ctrl_cv10, tuneGrid = data.frame(mtry = mtry_grid),
                 ntree = nt)
    cv10_tuning <- rbind(cv10_tuning, cbind(ntree = nt, fit$results))
  }
  print(paste('10-fold CV done after', round(difftime(Sys.time(), tuning_start,
                                                      units = "mins"), 1), 'minutes'))
}


################################################################################
#7. Tuning with leave-one-out cv (LOOCV, caret)
################################################################################
#One forest per observation is far too slow on the full data, so LOOCV runs on
#a subsample. It is only used to choose the hyperparameters; the final LOOCV
#model is refit on all training data.
#Limitation: LOOCV leaves out one bank-quarter at a time, so other quarters of
#the same bank can be in the training data. Its ROC-AUC is therefore optimistic.

#7a. Subsample -----------------------------------------------------------------

#Failures oversampled, so the subsample contains enough of them
set.seed(123)
n_fail_sub <- min(length(fail_idx), round(loocv_n * loocv_fail_share))
n_surv_sub <- min(length(surv_idx), loocv_n - n_fail_sub)

loocv_idx <- c(sample(fail_idx, n_fail_sub), sample(surv_idx, n_surv_sub))
loocv_x   <- train_x[loocv_idx, ]
loocv_y   <- train_y[loocv_idx]

table(loocv_y)   # check: class counts

ctrl_loocv <- trainControl(method          = "LOOCV",
                           classProbs      = TRUE,
                           summaryFunction = twoClassSummary)

#7b. Tuning --------------------------------------------------------------------

if (run_tuning) {
  tuning_start <- Sys.time()
  loocv_tuning <- NULL
  for (nt in ntree_grid) {
    set.seed(123)
    fit <- train(x = loocv_x, y = loocv_y, method = "rf", metric = "ROC",
                 trControl = ctrl_loocv, tuneGrid = data.frame(mtry = mtry_grid),
                 ntree = nt)
    loocv_tuning <- rbind(loocv_tuning, cbind(ntree = nt, fit$results))
  }
  print(paste('LOOCV done after', round(difftime(Sys.time(), tuning_start,
                                                 units = "mins"), 1), 'minutes'))
}

#7c. Save or load the tuning results -------------------------------------------

if (run_tuning) {
  save(cv10_tuning, loocv_tuning, file = "output/tuning_results.RData")
} else {
  load("output/tuning_results.RData")
}
